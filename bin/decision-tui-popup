#!/usr/bin/env bash
# Launch decision-tui as a tmux popup on the RIGHT client, serialized per client.
#
# Routing: with several Ghostty tabs (each a tmux client on one server), a bare
# `display-popup` lands on whatever client tmux last considered active — not
# necessarily the tab running the Claude that asked. We resolve the client
# attached to THIS session (via the launching pane $TMUX_PANE, inherited from
# the MCP server / Claude process) and target it explicitly with -c. This also
# fixes sub-agent calls, which share the MCP server's pane.
#
# Concurrency: tmux silently discards display-popup when the target client
# already shows a popup (exit 0, command never runs). flock queues them per
# client so concurrent dashboards wait their turn; callers poll their own
# answers file, so order is irrelevant.
#
# Notify: on open we fire a desktop notification (title + session + project) so
# a dashboard opening in a background tab doesn't go unnoticed.
#
# Usage: decision-tui-popup <spec.json> <answers.json>
set -u
if [ $# -ne 2 ]; then
    echo "usage: decision-tui-popup <spec.json> <answers.json>" >&2
    exit 2
fi
# display-popup runs its command in the tmux session's working directory, not
# the caller's — resolve paths now so relative arguments can't dangle
spec=$(realpath "$1")
answers=$(realpath -m "$2")
if [ -z "${TMUX:-}" ]; then
    echo "decision-tui-popup: not inside tmux" >&2
    exit 3
fi

# Resolve the target client (tab) from the launching pane's session.
target_client=""
target_session=""
pane_cwd=""
if [ -n "${TMUX_PANE:-}" ]; then
    target_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)
    pane_cwd=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_path}' 2>/dev/null || true)
fi
if [ -n "$target_session" ]; then
    target_client=$(tmux list-clients -t "$target_session" -F '#{client_name}' 2>/dev/null | head -n1)
fi

# lock per target client so concurrent popups on the same tab queue
lock_key=$(printf '%s' "${target_client:-default}" | tr -c 'a-zA-Z0-9' '_')
lock="/tmp/decision-tui-popup.$lock_key.lock"
title=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("title","decisions"))' "$spec" 2>/dev/null || echo decisions)

exec 9>"$lock"
flock 9

# Let Jake know which tab the dashboard is opening in (he runs several). Fired
# after flock so it coincides with the popup actually showing, not queueing.
if command -v notify-send >/dev/null 2>&1; then
    loc="tmux session: ${target_session:-?}"
    [ -n "$pane_cwd" ] && loc="$loc · ${pane_cwd/#$HOME/\~}"
    notify-send -a "Decision Dashboard" -u normal \
        "🗳  Decision dashboard ready" "$title"$'\n'"$loc" >/dev/null 2>&1 &
fi

popup_args=(-E -b rounded -T " $title " -w 92% -h 90%)
[ -n "$target_client" ] && popup_args+=(-c "$target_client")
exec tmux display-popup "${popup_args[@]}" "decision-tui '$spec' '$answers'"
