#!/usr/bin/env python3
"""PreToolUse hook: redirect every AskUserQuestion call to the dashboard tool.

This hook does NOT show the dashboard itself. For any AskUserQuestion it denies
the call *instantly* with a reason telling the model to call the
`mcp__decision-dashboard__present_decisions` MCP tool instead. That tool shows
the popup and returns the answers as a real tool result.

Doing it this way means the hook never blocks: the native UI is cancelled in
milliseconds (no concurrent-render race, no lingering UI), and the dashboard's
answers come back to the model as structured data rather than as deny-reason
text it must reinterpret.

The native picker is never used by choice. The only fall-throughs to native are
hard fallbacks where the dashboard *cannot* run: no tmux (the popup has nowhere
to render), no questions, or unparseable hook input.

Every run appends a line to /tmp/auq-hook.log for diagnosis.
"""

import json
import os
import sys
import time

LOG = "/tmp/auq-hook.log"


def log(msg: str) -> None:
    try:
        with open(LOG, "a") as f:
            f.write(f"[{time.strftime('%F %T')}] {msg}\n")
    except OSError:
        pass


def respond(decision: str, reason: str = "") -> None:
    out = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": decision}}
    if reason:
        out["hookSpecificOutput"]["permissionDecisionReason"] = reason
    print(json.dumps(out))
    sys.exit(0)


def allow(why: str) -> None:
    log(f"allow (native UI): {why}")
    respond("allow")


REDIRECT = (
    "Do NOT use AskUserQuestion here. Instead call the MCP tool "
    "mcp__decision-dashboard__present_decisions to show Jake an interactive "
    "dashboard, which is far easier for him to digest than the native picker.\n\n"
    "Convert the questions you were about to ask into the tool's `decisions` "
    "argument: one object per question with a unique `id`, the `question` text, "
    "`type` ('single', or 'multi' if multiple answers are allowed), and "
    "`options` (list of {label, description}). Put any supporting detail "
    "(tables, evidence, the items being decided on) in each decision's "
    "`context_md` as markdown — the richer the better; this is the whole point "
    "of the dashboard. Give the call a short `title`.\n\n"
    "Use the tool's returned answers as Jake's response and proceed. Only if it "
    "returns status 'unavailable' should you fall back to AskUserQuestion."
)


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except Exception as e:
        allow(f"unparseable stdin: {e}")
    questions = (payload.get("tool_input") or {}).get("questions") or []
    if not questions:
        allow("no questions in tool_input")
    if not os.environ.get("TMUX"):
        allow("TMUX not set — dashboard cannot show")

    log(f"redirect {len(questions)} question(s) to present_decisions")
    respond("deny", REDIRECT)


if __name__ == "__main__":
    main()
